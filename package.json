{
  "name": "autobots-playwright-migration",
  "version": "1.0.0",
  "private": true,
  "description": "Selenium C# NUnit to Playwright TypeScript starter package",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:sample": "playwright test tests/neonatal/T386672_Employee_Books_Neonatal_Playwright.spec.ts",
    "install:browsers": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.13.5",
    "typescript": "^5.8.2"
  }
}
